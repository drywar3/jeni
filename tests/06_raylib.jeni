
Color :: struct {
    r: uint8;
    g: uint8;
    b: uint8;
    a: uint8;
}

make_color :: func (r: uint8, g: uint8, b: uint8, a: uint8) -> Color {
    x: Color;
    x.r = r;
    x.g = g;
    x.b = b;
    x.a = a;
    return x;
}

SCREEN_WIDTH  :: 800;
SCREEN_HEIGHT :: 600;

main :: func () {
    RED   := make_color(cast 255, cast 0,    cast 0,    cast 255);
    BLUE  := make_color(cast 0,    cast 0,    cast 255, cast 255);
    GREEN := make_color(cast 0,    cast 255, cast 0,    cast 255);

    set_log_level(LOG_NONE);

    init_window(SCREEN_WIDTH, SCREEN_HEIGHT, c"06-raylib");
    set_target_fps(60);

    printf(c"0xFF = %d\n", 0xFF);
    printf(c"0b11 = %d\n", 0b11);
    printf(c"0o17 = %d\n", 0o17);

    x_pos : float = 400.;
    y_pos : float = 300.;

    SIZE : int : 50;
    inc := 2;

    for !window_should_close() {
        begin_drawing();
        clear_background(RED);

        draw_rectangle(cast x_pos, cast y_pos, SIZE, SIZE, GREEN);

        x_pos = x_pos + cast inc;
        //y_pos = y_pos + inc;

        if cast<int> x_pos + SIZE >= SCREEN_WIDTH {
            inc = 0-inc;
            x_pos = SCREEN_WIDTH - SIZE - 10;
        }

        if x_pos <= cast 0 {
            inc = 0-inc;
            x_pos = 10;
        }

        end_drawing();
    }

    close_window();
}

set_log_level  :: func (x : int) #canon_name "SetTraceLogLevel" ---
printf :: func (fmt: *const char, ...) -> int #canon_name "printf" ---

init_window         :: func (a : int, b: int, c : *const char) #canon_name "InitWindow" ---
close_window        :: func () #canon_name "CloseWindow"  ---
begin_drawing       :: func () #canon_name "BeginDrawing" ---
window_should_close :: func () -> bool #canon_name "WindowShouldClose" ---
end_drawing         :: func () #canon_name "EndDrawing" ---
clear_background    :: func (color : Color) #canon_name "ClearBackground" ---
color_from_hsv      :: func (hue: float, saturation: float, value: float) -> Color #canon_name "ColorFromHsv" ---
draw_rectangle      :: func (posX: int, posY: int, width: int, height: int, color: Color) #canon_name "DrawRectangle" ---
draw_circle         :: func (centerX: int, centerY: int, radius: float, color: Color) #canon_name "DrawCircle" ---
set_target_fps      :: func (fps: int) #canon_name "SetTargetFPS" ---

LOG_ALL     :: 0;
LOG_TRACE   :: 1;
LOG_DEBUG   :: 2;
LOG_INFO    :: 3;
LOG_WARNING :: 4;
LOG_ERROR   :: 5;
LOG_FATAL   :: 6;
LOG_NONE    :: 7;
