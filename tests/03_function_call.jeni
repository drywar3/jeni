main :: func () -> int {
     puts(c"Hello World");
     x := atoi(c"720100000");
     printf(c"x = %d\n", x);

     set_log_level(LOG_NONE);
     printf(c"----------------------------------------------------\n");
     data := load_file_text(c"./tests/02_hello_world.jeni");
     puts(data);
     printf(c"----------------------------------------------------\n");
}

LOG_ALL     :: 0;
LOG_TRACE   :: 1;
LOG_DEBUG   :: 2;
LOG_INFO    :: 3;
LOG_WARNING :: 4;
LOG_ERROR   :: 5;
LOG_FATAL   :: 6;
LOG_NONE    :: 7;

puts        :: func (b : *const char)               #canon_name "puts"    ---
printf      :: func (b : *const char, ...) -> int   #canon_name "printf"  ---
putchar     :: func (c : int)                       #canon_name "putchar" ---
atoi        :: func (d: *const char) -> int         #canon_name "atoi"    ---

init_window    :: func (a : int, b: int, c : *const char) #canon_name "InitWindow"       ---
load_file_text :: func (file_path: *const char) -> *char  #canon_name "LoadFileText"     ---
set_log_level  :: func (x : int)                          #canon_name "SetTraceLogLevel" ---
